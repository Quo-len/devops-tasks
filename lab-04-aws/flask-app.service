[Unit]
Description=Flask Web Application on AWS EC2
After=network.target

[Service]
User=root
WorkingDirectory=/home/ubuntu/devops-tasks/lab-04-aws
ExecStart=/usr/local/bin/gunicorn --config /home/ubuntu/devops-tasks/lab-04-aws/gunicorn.conf.py app:app
Restart=always
RestartSec=5
Environment=PORT=80

[Install]
WantedBy=multi-user.target

